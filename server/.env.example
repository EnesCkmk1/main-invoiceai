# --- Core ---
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
APP_URL=http://localhost:5173

# --- Database ---
DATABASE_URL="postgresql://invoiceflow:invoiceflow@localhost:5432/invoiceflow?schema=public"

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Email (optional; logs to console if unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="InvoiceFlow AI <no-reply@invoiceflow.ai>"

# --- Google login (optional) ---
GOOGLE_CLIENT_ID=

# --- Stripe (optional; enables online payments + subscription billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- AI (optional; app works fully without it via the rule-based engine) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
